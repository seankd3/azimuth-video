#!/bin/bash
# heavy [-l LANE] [-w] NAME COMMAND...: run a heavy job as the user unit NAME, in a queue that keeps the desktop's memory.
#
# - It survives the app or terminal that started it: NAME is a systemd user unit, active while the job waits and runs,
#   and the job's output is in journalctl --user -u NAME-job. With -w it runs in the foreground instead: its output and
#   exit code come back here.
# - A queue: the job waits behind earlier jobs of its lane until it fits. It fits when the jobs running in its lane's
#   slice, each counted at its lane's peak or its memory now (whichever is more), leave room for its own peak under the
#   slice's ceiling (MemoryMax), and the machine has its peak plus 4 GB free. A job waiting holds nothing, so the slots
#   follow the slice and the peaks: gpu.slice holds one GPU job.
# - A ceiling: the job runs in its lane's slice with no swap and no soft cap, so at the ceiling the kernel stops it at
#   once; it never crawls.
# - It runs as if it ran here: in this folder, with this shell's environment. Without -w, systemd expands $VAR in
#   COMMAND once, as it did before the queue; with -w, COMMAND runs as given.
# - The GPU: GPU work runs only in gpu.slice, the media lane's own slice, outside every other job's ceiling. A GPU job
#   under reclaim holds the driver's global lock, which the compositor waits on to draw: in a slice with swap or under
#   another ceiling that froze the desktop (twice). ffmpeg-gpu and the library run refuse to start anywhere else.
#   Allocations through the GPU driver are not counted against the slice on a machine whose GPU shares system memory,
#   so the 4 GB free beside the peak is theirs. JAX takes 75% of GPU memory up front by default, which once froze a desktop, so JAX allocates as it
#   goes and never takes more than 20%; PyTorch frees what it no longer uses.
#
# A lane is a kind of job, the slice it runs in and the memory its runs peak at, in GB.
lanes='
media  gpu.slice       12 a library run, a render or a model job on the GPU: a library run peaked near 12 GB
dev    app-heavy.slice 5  a test suite, a build or a type check: 1,035 such runs on one machine peaked at 4.9 GB (p99)
review app-heavy.slice 2  a code review by a model: 96 such runs on one machine peaked at 1.9 GB (max)
'
set -eu
lane=media wait=
while getopts l:w opt; do case $opt in l) lane=$OPTARG;; w) wait=1;; *) exit 2;; esac; done
shift $((OPTIND - 1))
[ $# -ge 2 ] || { echo "usage: heavy [-l LANE] [-w] NAME COMMAND..." >&2; exit 2; }
read -r slice gb < <(awk -v l="$lane" '$1 == l {print $2, $3}' <<<"$lanes")
[ -n "${gb:-}" ] || { echo "heavy: no lane $lane; the lanes are: $(awk 'NF {printf "%s ", $1}' <<<"$lanes")" >&2; exit 2; }
name=$1; shift
env=(); for v in $(compgen -e); do case $v in *[!A-Za-z0-9_]*|HEAVY_GB|INVOCATION_ID|JOURNAL_STREAM|MANAGERPID|NOTIFY_SOCKET|LISTEN_*|SYSTEMD_*) ;; *) env+=("--setenv=$v");; esac; done

# Without -w, the unit NAME waits in the queue and then follows the job: it runs heavy -w for it, so NAME is active
# from now, ends with the job's exit code, and stopping it stops the job.
[ -n "$wait" ] || exec systemd-run --user --quiet --collect --unit="$name" --working-directory="$PWD" "${env[@]}" \
  "$(readlink -f "$0")" -l "$lane" -w "$name-job" "$@"

G=$((1 << 30)) need=$((gb << 30))
fits() {
  local max used=0 units=0 cur unit peak cg
  max=$(systemctl --user show -P MemoryMax "$slice")
  # A slice with no job running has no cgroup, and then it holds nothing.
  cg=$(systemctl --user show -P ControlGroup "$slice")
  if [ -n "$cg" ]; then
    cg=/sys/fs/cgroup$cg
    for unit in "$cg"/*.service "$cg"/*.scope; do
      [ -e "$unit/memory.current" ] || continue
      cur=$(cat "$unit/memory.current"); peak=$(systemctl --user show -P Environment "${unit##*/}" | grep -o 'HEAVY_GB=[0-9]*' | cut -d= -f2)
      peak=$(( ${peak:-0} * G )); used=$(( used + (cur > peak ? cur : peak) )); units=$((units + 1))
    done
    # The file cache that ended jobs left charged to the slice counts against its ceiling and its MemoryLow shields
    # it, so it goes back first.
    cur=$(cat "$cg/memory.current" 2>/dev/null || echo 0)
    [ $((cur - used)) -le 0 ] || echo $((cur - used)) > "$cg/memory.reclaim" 2>/dev/null || true
  fi
  [ $(( $(awk '/MemAvailable/ {print $2}' /proc/meminfo) * 1024 )) -ge $((need + 4 * G)) ] || return 1
  [ "$units" = 0 ] || [ "$max" = infinity ] || [ $((used + need)) -le "$max" ]
}

# Jobs of one lane start in the order they came; a lane that waits for room holds up no other lane. The admission lock
# is held only to check and start, so two lanes never both take the same room.
exec 8>"$HOME/.cache/heavy-$lane.lock" 9>"$HOME/.cache/heavy-admit.lock"
flock 8
until flock 9 && fits; do flock -u 9; sleep 10; done
systemd-run --user --quiet --collect --wait --pipe --expand-environment=no --unit="$name" --slice="$slice" --working-directory="$PWD" "${env[@]}" \
  --setenv=HEAVY_GB="$gb" --setenv=XLA_PYTHON_CLIENT_PREALLOCATE=false --setenv=XLA_PYTHON_CLIENT_MEM_FRACTION=0.2 \
  --setenv=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True "$@" <&0 8>&- 9>&- &
run=$!
trap 'systemctl --user stop "$name"' INT TERM
until systemctl --user is-active --quiet "$name" || ! kill -0 "$run" 2>/dev/null; do sleep 0.2; done
exec 8>&- 9>&-
wait "$run"
