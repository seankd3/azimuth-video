[Unit]
Description=Heavy CPU jobs (heavy's dev and review lanes): one ceiling for all of them

[Slice]
# heavy starts a job only while its lane's peak fits under MemoryMax beside the jobs already running. No soft cap and
# no swap: a runaway past its peak dies at the ceiling instead of crawling in the reclaim under it.
MemoryMax=16G
MemorySwapMax=0
# When other work fills memory, systemd-oomd stopped the heavy job first every time, so it keeps 8 GB the rest can't
# reclaim; its own ceiling still stops it at MemoryMax.
MemoryLow=8G
CPUWeight=20
IOWeight=20
